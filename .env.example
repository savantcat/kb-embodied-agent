# ===== 魔珐星云（密钥只在服务端 .env，切勿提交真实值）=====
# 获取方式：登录 https://xingyun3d.com/ → 控制台 → 应用管理 → 创建驱动应用（选角色/音色/表演风格）
#           → 复制 App ID / App Secret
# 留空 = 数字人不可用：后端会如实拒绝并在页面上说明原因，文字 + 卡片版照常（推荐的安全默认）。
# ⚠️ 不要填 your_app_id 这类占位文字 —— 它「非空」但不是有效凭证，会被判为未配置。
#     要开数字人，就填星云控制台的真实 App ID / App Secret（各 32 位）。
XMOV_APP_ID=
XMOV_APP_SECRET=
# 公共网关（固定值，私有化部署才需改）
XMOV_GATEWAY=https://nebula-agent.xingyun3d.com/user/v1/ttsa_v2/session
# 端到端版 SDK 地址（默认即官方 CDN，一般不用改）
XMOV_SDK_URL=https://media.xingyun3d.com/xingyun3d/general/litesdk/xmovAvatar_e2e@latest.js

# ===== 大模型（OpenAI 兼容）=====
# 我方 Agent 自有大脑：SDK 侧 brain_config.auto_send_asr_to_llm=false，识别文本交回本服务
LLM_BASE_URL=https://api.deepseek.com/v1
# 留空 = 不调用大模型，走本地骨架输出（页面会说明原因，不会报 401）。
# ⚠️ 同样不要填 your_llm_key 这类占位文字 —— 会被判为未配置。
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ===== 企业知识库 =====
# 留空 = 自动按代码位置解析到仓库根 kb/（推荐）；也可指定绝对路径
KB_PATH=

# ===== 行动层：自研 MCP 工具服务 =====
MCP_SERVER_URL=http://mcp:8100/mcp

# ===== 运行模式：online=真实数字人；offline=离线演示（不消耗积分）=====
DEMO_MODE=online
SESSION_TTL_SECONDS=900

# ===== 数字人开放控制（B 方案：半开放）=====
# 后台开关口令（留空=仅本机 127.0.0.1 可管理；公网部署必须设置）
ADMIN_TOKEN=
# 单场秒数 / 每日场次上限 / 每日积分上限 / 单 IP 每日场次
AVATAR_TTL=180
# 无心跳多久判定掉线并主动释放名额（秒）
AVATAR_IDLE=45
AVATAR_DAILY_SESSIONS=30
AVATAR_DAILY_POINTS=60
IP_DAILY_SESSIONS=2
# 计费口径（实测 0.5 积分/分钟，仅用于估算展示）
POINTS_PER_MIN=0.5

# 数字人默认开关：on=启动即开放数字人演示；off=默认关闭，由后台开关控制（生产建议 off）
AVATAR_DEFAULT=on
